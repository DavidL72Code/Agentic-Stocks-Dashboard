# ══════════════════════════════════════════════════════════
#  Monsoon — configuration
#  Copy to .env and fill in. .env is gitignored; this file is not.
#      cp .env.example .env
#  NOTHING here is required for the dashboard: quotes, charts,
#  financials, news, analysts, events and the daily overview all
#  work with no keys at all. Keys only switch on the agent layer.
# ══════════════════════════════════════════════════════════

# ── Agent (optional) ──────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
# Without this the dashboard is fully functional; the Ask box,
# Analyze buttons and the written daily brief are disabled.
GEMINI_API_KEY=

# Model used for synthesis and the final write-up.
GEMINI_MODEL=gemini-2.5-flash

# Cheaper/faster model for tool selection and the guard.
# Leave blank to reuse GEMINI_MODEL.
GEMINI_FAST_MODEL=gemini-2.5-flash

# Gemini's OpenAI-compatible endpoint. NOT a "maybe switch providers" knob:
# the client is langchain_openai.ChatOpenAI, which otherwise defaults to
# api.openai.com. This URL is what makes it reach Gemini at all.
# llm.py already defaults to exactly this value, so you can delete the line
# and nothing changes - it is here so the endpoint is visible, not hidden.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Only if you repoint LLM_BASE_URL at OpenAI instead of Gemini.
OPENAI_API_KEY=

# ── SEC EDGAR (recommended) ───────────────────────────────
# The SEC returns 403 to any User-Agent without an email-shaped
# contact. Put your own address here per their fair-access policy.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=monsoon/0.1 (you@example.com)

# ── Storage ───────────────────────────────────────────────
# SQLite file holding users, portfolios, positions, watchlist.
DB_PATH=data/monsoon.db

# Legacy single-file store. Only read once, to import into SQLite on first
# run, then renamed to .migrated. Safe to leave as-is.
STORE_PATH=data/store.json

# ── Database ──────────────────────────────────────────────
# Default: a local SQLite file. Nothing to configure.
# To run on Turso instead (free, and a free db is NOT paused for inactivity),
# set both of these and `pip install libsql-experimental`. See DATABASE.md.
# TURSO_DATABASE_URL=libsql://monsoon-<you>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create monsoon>

# ── Cache (optional) ──────────────────────────────────────
# Unset, the market-data cache is an in-process dict: fine, but it dies on
# every restart and is not shared between workers. Point REDIS_URL at a Redis
# and it becomes a second tier behind that dict. Sessions and the login
# throttle stay in SQLite on purpose, so a Redis outage costs cache misses and
# never a login. Needs `pip install redis`. See DATABASE.md.
# REDIS_URL=redis://localhost:6379/0
# REDIS_PREFIX=monsoon:v1
# REDIS_STALE_FACTOR=12
# Socket budget in seconds. 0.25 suits a Redis on the same machine; a MANAGED
# Redis in another region needs 1-2 or the circuit breaker trips on latency and
# you silently get no cache (check "paused" in /api/health).
# REDIS_TIMEOUT=0.25

# ── Auth ──────────────────────────────────────────────────
# Username + password sign-in is built in and needs no configuration here.
# Set false to run the old single-implicit-user mode (what the eval harness
# uses when it wants no login at all).
AUTH_ENABLED=true

# Your public origin. This does MORE than OAuth redirects: the session cookie's
# Secure flag is derived from it, so leaving it http:// in production ships
# every cookie without Secure. The app logs a warning at startup if you do.
# Must also match the redirect URI you register with any OAuth provider.
APP_BASE_URL=http://localhost:8077
SESSION_DAYS=30

# Browser origins allowed to call the API cross-origin. Defaults to
# APP_BASE_URL plus localhost, which is right when the UI is served by this
# same app. Only set this if you host the frontend somewhere else.
# CORS_ORIGINS=https://monsoon.example.com

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL:
#   http://localhost:8077/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
#   Authorised redirect URI:
#   http://localhost:8077/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
