# cp .env.example .env
# Uncommented = you set it. Commented = the code already has a working default.
# What each one does: HOSTING.md

GEMINI_API_KEY=
SEC_USER_AGENT=monsoon/0.1 (you@example.com)
APP_BASE_URL=http://localhost:8077

# ── required on Render (no persistent disk: a SQLite file dies each deploy) ──
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── recommended on Render: Yahoo blocks its crumb there, so P/E, market cap,
#    margins and analyst ratings come from Finnhub instead (free key, finnhub.io) ──
# FINNHUB_API_KEY=

# ── agent: 0 turns off the one bounded follow-up round ──
# AGENT_FOLLOWUP=1

# ── optional cache tier (rediss:// for managed; raise the timeout or the
#    circuit breaker trips on latency rather than failure) ──
# REDIS_URL=
# REDIS_TIMEOUT=1
# REDIS_PREFIX=monsoon:v1
# REDIS_STALE_FACTOR=12

# ── these have defaults; set one only to override it ──
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FAST_MODEL=            # falls back to GEMINI_MODEL
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AUTH_ENABLED=true
# SESSION_DAYS=30
# DB_PATH=data/monsoon.db
# STORE_PATH=data/store.json    # legacy, imported once then renamed
# CORS_ORIGINS=                 # only if the frontend is on another origin

# ── optional oauth ──
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── only if you repoint LLM_BASE_URL at openai ──
# OPENAI_API_KEY=
