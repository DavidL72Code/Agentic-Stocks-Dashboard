# cp .env.example .env
# What each one does: HOSTING.md

# ── set these ──
GEMINI_API_KEY=
SEC_USER_AGENT=monsoon/0.1 (you@example.com)

# ── hosting ──
APP_BASE_URL=http://localhost:8077
AUTH_ENABLED=true
DB_PATH=data/monsoon.db

# ── defaults, change only if you need to ──
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SESSION_DAYS=30
STORE_PATH=data/store.json

# ── optional: hosted database ──
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── optional: redis cache ──
# REDIS_URL=
# REDIS_PREFIX=monsoon:v1
# REDIS_STALE_FACTOR=12
# REDIS_TIMEOUT=0.25

# ── optional: frontend on a different origin ──
# CORS_ORIGINS=

# ── optional: oauth ──
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── only if you repoint LLM_BASE_URL at openai ──
# OPENAI_API_KEY=
