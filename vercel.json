{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh scripts/build-web.sh",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/api/:path*", "destination": "https://agentic-stocks-dashboard.onrender.com/api/:path*" },
    { "source": "/build", "destination": "https://agentic-stocks-dashboard.onrender.com/build" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/:file(app|charts).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
